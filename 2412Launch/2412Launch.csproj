<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Conduct Dyadra Modal</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <Version>2.0.0-Pre-Release</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <InformationalVersion>V2.0.00-Pre-Release</InformationalVersion>
    <Company>Conduct Dyadra Modal</Company>
    <Product>Conduct Dyadra Modal</Product>
    <Description>Conduct Dyadra Modal launcher with embedded engine payload.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\NativeSamples\D3D12_8x8_engine\build\Release\D3D12_8x8_engine.exe">
      <Link>NativeSamples\D3D12_8x8_engine\build\Release\D3D12_8x8_engine.exe</Link>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="..\NativeSamples\D3D12_8x8_engine\build\Release\D3D12_8x8_launcher.exe">
      <Link>NativeSamples\D3D12_8x8_engine\build\Release\D3D12_8x8_launcher.exe</Link>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="PayloadAudio\Obsidian Bazaar Chillhop.mp3">
      <Link>NativeSamples\D3D12_8x8_engine\build\Release\Obsidian Bazaar Chillhop.mp3</Link>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="PayloadAudio\Obsidian Bazaar Chillhop (1).mp3">
      <Link>NativeSamples\D3D12_8x8_engine\build\Release\Obsidian Bazaar Chillhop (1).mp3</Link>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="PayloadAudio\Obsidian Bazaar Chillhop (2).mp3">
      <Link>NativeSamples\D3D12_8x8_engine\build\Release\Obsidian Bazaar Chillhop (2).mp3</Link>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>