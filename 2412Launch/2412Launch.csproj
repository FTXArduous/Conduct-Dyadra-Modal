<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Conduct Dyadra Modal</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\NativeSamples\D3D12_8x8_engine\build\Release\D3D12_8x8_engine.exe">
      <LogicalName>Payload.D3D12_8x8_engine.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\NativeSamples\D3D12_8x8_engine\build\Release\D3D12_8x8_launcher.exe">
      <LogicalName>Payload.D3D12_8x8_launcher.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>